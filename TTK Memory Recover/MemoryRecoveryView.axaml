<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TtkMemoryRecover.MemoryRecoveryView">
    <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="0,12,0,0">
        <Border Grid.Row="0" Classes="card" Padding="14,12">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="SaveButton" Classes="primary" Content="Save As..." IsEnabled="False"
                        Click="SaveButton_Click" />
                <TextBlock Classes="muted" VerticalAlignment="Center"
                           Text="Select times to scan for flag blocks (3+ x AA). Apply marks the flag block and the repeat block after it for deletion." />
            </StackPanel>
        </Border>
        <TextBlock Grid.Row="1" x:Name="StatusText" Margin="4,10" TextWrapping="Wrap" />
        <Border Grid.Row="2" Classes="card" Padding="12,8" MaxHeight="220">
            <ScrollViewer>
                <StackPanel x:Name="TimesHost" Spacing="2" />
            </ScrollViewer>
        </Border>
        <Border Grid.Row="3" Classes="card" Padding="14,10" Margin="0,12,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="14" Margin="0,0,0,8">
                    <TextBlock x:Name="MatchesHeader" FontWeight="SemiBold" Text="Matches" />
                    <Border Background="#E5E7EB" CornerRadius="4" Padding="6,1">
                        <TextBlock Text="Repeat block" Foreground="#374151" FontSize="12" />
                    </Border>
                    <Border Background="#FEE2E2" CornerRadius="4" Padding="6,1">
                        <TextBlock Text="Flag block" Foreground="#B91C1C" FontSize="12" />
                    </Border>
                </StackPanel>
                <ScrollViewer>
                    <StackPanel x:Name="MatchesHost" Spacing="6" />
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
