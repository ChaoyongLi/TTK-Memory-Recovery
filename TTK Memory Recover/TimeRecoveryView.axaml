<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TtkMemoryRecover.TimeRecoveryView">
    <Grid RowDefinitions="Auto,Auto,*" Margin="0,12,0,0">
        <Border Grid.Row="0" Classes="card" Padding="14,12">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="DepthButton" Classes="secondary" Content="Depth File..." Click="DepthButton_Click" />
                <Button x:Name="SaveButton" Classes="primary" Content="Save As..." Click="SaveButton_Click" />
                <TextBlock x:Name="DepthInfo" Classes="muted" VerticalAlignment="Center"
                           Text="No depth file loaded." />
            </StackPanel>
        </Border>
        <TextBlock Grid.Row="1" x:Name="StatusText" Margin="4,10" TextWrapping="Wrap" />
        <Border Grid.Row="2" Classes="card" Padding="14,10">
            <DockPanel>
                <Grid DockPanel.Dock="Top" ColumnDefinitions="50,220,*" Margin="0,0,0,8">
                    <TextBlock Grid.Column="0" Classes="columnHeader" Text="#" />
                    <TextBlock Grid.Column="1" Classes="columnHeader" Text="CURRENT TIME" />
                    <TextBlock Grid.Column="2" Classes="columnHeader" Text="REPLACE WITH" />
                </Grid>
                <ScrollViewer>
                    <StackPanel x:Name="RowsHost" Spacing="6" />
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
